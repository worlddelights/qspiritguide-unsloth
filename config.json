{
  "lm_studio": {
    "base_url": "http://mac.tail7b2593.ts.net:12434/v1",
    "api_key": "lm-studio",
    "model": "google/gemma-4-e4b"
  },
  "wiki": {
    "max_context_token": 33333,
    "temperature": 0.5,
    "enable_thinking": false
  },
  "finetune": {
    "models": {
      "llama-3.2-1b": {
        "base_model": "meta-llama/Llama-3.2-1B-Instruct"
      },
      "smollm2-360m": {
        "base_model": "HuggingFaceTB/SmolLM2-360M-Instruct"
      },
      "smollm2-135m": {
        "base_model": "HuggingFaceTB/SmolLM2-135M-Instruct"
      }
    },
    "training": {
      "max_seq_length": 2048,
      "load_in_4bit": true,
      "lora_rank": 16,
      "lora_alpha": 16,
      "per_device_train_batch_size": 2,
      "gradient_accumulation_steps": 4,
      "warmup_steps": 5,
      "num_train_epochs": 1,
      "learning_rate": 0.0002,
      "logging_steps": 10,
      "weight_decay": 0.01,
      "seed": 3407
    }
  }
}